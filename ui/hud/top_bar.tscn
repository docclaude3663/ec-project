popup/item_0/text = "save"
popup/item_0/id = 0
popup/item_1/text = "load"
popup/item_1/id = 1
popup/item_2/text = "++"
popup/item_2/id = 2
popup/item_2/separator = true
popup/item_3/text = "ничего"
popup/item_3/id = 3
popup/item_4/text = "jolt profile"
